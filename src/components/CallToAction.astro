---
import { Heading } from 'accessible-astro-components'

interface Props {
  title?: string
  description?: string
  primaryHref?: string
  primaryLabel?: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  title = 'Come to a chapter event',
  description = 'Events are open to Rice students. There is no application.',
  primaryHref = '/events',
  primaryLabel = 'View Events',
  secondaryHref = '/get-involved',
  secondaryLabel = 'Get involved',
} = Astro.props
---

<section class="cta-band">
  <div class="container">
    <Heading level="h2">{title}</Heading>
    {description && <p>{description}</p>}
    <div class="cta-actions">
      <a class="button button-light" href={primaryHref}>{primaryLabel}</a>
      <a class="button button-ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
