---
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

interface Props {
  title?: string
  link?: string
  linkText?: string
}

const {
  title = 'Join the Rice University SIAM Student Chapter',
  link = '/join',
  linkText = 'Learn how to join',
} = Astro.props
---

<div class="container">
  <div class="call-to-action mt-24 mb-32 flex flex-col items-center gap-12 rounded-xl px-12 py-20 md:px-24">
    <Heading level="h2" class="text-center text-3xl md:text-5xl">{title}</Heading>
    <Link href={link} isButton size="lg">
      {linkText}
      <Icon aria-hidden="true" name="lucide:arrow-right" size="1.5rem" />
    </Link>
  </div>
</div>

<style lang="scss">
  .call-to-action {
    border: 1px solid var(--border-color-subtle);
    background-color: light-dark(var(--color-primary-100), var(--color-neutral-800));
    color: var(--foreground-color);
  }
</style>
