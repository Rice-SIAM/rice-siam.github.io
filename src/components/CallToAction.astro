---
import { Heading } from 'accessible-astro-components'

interface Props {
  title?: string
  description?: string
  primaryHref?: string
  primaryLabel?: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  title = 'Join the Rice University SIAM Student Chapter',
  description = 'A student community for applied mathematics, computational science, and related fields at Rice University.',
  primaryHref = '/join',
  primaryLabel = 'Join Rice SIAM',
  secondaryHref = '/contact',
  secondaryLabel = 'Contact',
} = Astro.props
---

<section class="cta-band">
  <div class="container">
    <Heading level="h2">{title}</Heading>
    {description && <p>{description}</p>}
    <div class="cta-actions">
      <a class="button button-light" href={primaryHref}>{primaryLabel}</a>
      <a class="button button-ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
