---
import EventCard from './EventCard.astro'
import type { EventEntry } from '@utils/events'

interface Props {
  events: EventEntry[]
  headingLevel?: 'h2' | 'h3'
  emptyMessage?: string
}

const {
  events,
  headingLevel = 'h3',
  emptyMessage = 'No upcoming events posted yet. Check back soon.',
} = Astro.props
---

{
  events.length === 0 ? (
    <div class="empty-state">
      <p>{emptyMessage}</p>
    </div>
  ) : (
    <ul class="event-list">
      {events.map((event) => (
        <li>
          <EventCard event={event} headingLevel={headingLevel} />
        </li>
      ))}
    </ul>
  )
}
