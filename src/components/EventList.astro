---
import EventCard from './EventCard.astro'
import type { EventEntry } from '@utils/events'

interface Props {
  events: EventEntry[]
  headingLevel?: 'h2' | 'h3' | 'h4'
  emptyMessage?: string
  labelledBy?: string
}

const { events, headingLevel = 'h3', emptyMessage = 'No upcoming events are listed.', labelledBy } = Astro.props
---

{
  events.length === 0 ? (
    <div class="empty-state">
      <p>{emptyMessage}</p>
    </div>
  ) : (
    <ul class="event-list" aria-labelledby={labelledBy}>
      {events.map((event) => (
        <li>
          <EventCard event={event} headingLevel={headingLevel} />
        </li>
      ))}
    </ul>
  )
}
