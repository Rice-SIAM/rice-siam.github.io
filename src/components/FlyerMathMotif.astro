---
interface Props {
  kind: 'feature' | 'internships' | 'jobs' | 'fellowships' | 'meetings'
}

const { kind } = Astro.props
---

<svg class:list={['card-motif', `motif-${kind}`]} viewBox="0 0 160 110" aria-hidden="true" focusable="false">
  {
    kind === 'feature' ? (
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.2">
        <path d="M8 62 C28 28 44 28 64 62 S100 96 120 62 152 28 160 44" opacity="0.95" />
        <path d="M8 78 C28 108 44 108 64 78 S100 48 120 78 152 108 160 92" opacity="0.7" />
        <circle cx="64" cy="62" r="3.4" fill="currentColor" stroke="none" />
        <circle cx="120" cy="62" r="3.4" fill="currentColor" stroke="none" />
      </g>
    ) : null
  }
  {
    kind === 'internships' ? (
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 96 H148 M18 96 V14" stroke-width="1.8" opacity="0.55" />
        <path d="M22 90 C40 88 48 72 62 58 C78 42 90 36 112 24 C128 16 138 14 150 10" stroke-width="2.4" />
        <circle cx="62" cy="58" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="112" cy="24" r="3.2" fill="currentColor" stroke="none" />
        <path d="M36 90 V74 H52 V60 H70 V44 H90 V30 H112" stroke-width="1.7" opacity="0.55" />
      </g>
    ) : null
  }
  {
    kind === 'jobs' ? (
      <g stroke="currentColor" stroke-linecap="round">
        <g fill="none" stroke-width="1.8" opacity="0.85">
          <path d="M28 78 L58 40 L96 32" />
          <path d="M58 40 L84 72 L124 58" />
          <path d="M96 32 L124 58 L138 24" />
          <path d="M28 78 L84 72" />
        </g>
        <g fill="currentColor" stroke="none">
          <circle cx="28" cy="78" r="5" />
          <circle cx="58" cy="40" r="5.5" />
          <circle cx="96" cy="32" r="5" />
          <circle cx="84" cy="72" r="4.5" />
          <circle cx="124" cy="58" r="5" />
          <circle cx="138" cy="24" r="4.2" />
        </g>
      </g>
    ) : null
  }
  {
    kind === 'fellowships' ? (
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <circle cx="86" cy="54" r="16" stroke-width="2.2" />
        <circle cx="86" cy="54" r="28" stroke-width="1.7" opacity="0.8" />
        <circle cx="86" cy="54" r="40" stroke-width="1.4" opacity="0.55" />
        <path d="M86 14 V94 M46 54 H126 M58 26 L114 82 M114 26 L58 82" stroke-width="1.2" opacity="0.45" />
        <circle cx="86" cy="54" r="3.4" fill="currentColor" stroke="none" />
      </g>
    ) : null
  }
  {
    kind === 'meetings' ? (
      <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8">
        <path d="M80 12 L132 44 L112 98 L48 98 L28 44 Z" opacity="0.9" />
        <path d="M80 12 L80 98 M28 44 L132 44 M48 98 L80 12 L112 98" opacity="0.7" />
        <circle cx="80" cy="12" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="132" cy="44" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="112" cy="98" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="48" cy="98" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="28" cy="44" r="3.2" fill="currentColor" stroke="none" />
        <circle cx="80" cy="54" r="3.2" fill="currentColor" stroke="none" />
      </g>
    ) : null
  }
</svg>
