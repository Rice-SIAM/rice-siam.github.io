---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import themeConfig from '@theme-config'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

const currentYear = new Date().getFullYear()
const navItems = themeConfig.navigation.items.filter((item) => item.type !== 'dropdown')
const socials = themeConfig.socials ?? []
---

<footer>
  <CallToAction />
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">On this site</Heading>
        <ul class="flex flex-col gap-2">
          {
            navItems.map((item) =>
              item.type !== 'dropdown' ? (
                <li>
                  <Link href={item.href} isExternal={item.external ?? false}>
                    {item.label}
                  </Link>
                </li>
              ) : null,
            )
          }
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">Connect</Heading>
        <ul class="flex flex-col gap-2">
          {
            socials.map((item) => (
              <li>
                <Link href={item.href} isExternal={item.external ?? true}>
                  <span class="inline-flex items-center gap-2">
                    <Icon aria-hidden="true" name={item.icon} size="1.15rem" />
                    {item.label}
                  </span>
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" />
        <p>
          A student chapter of the Society for Industrial and Applied Mathematics at Rice University.
        </p>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} Rice University SIAM Student Chapter.
      </p>
      <p>
        <Link href="/accessibility-statement">Accessibility statement</Link>
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
