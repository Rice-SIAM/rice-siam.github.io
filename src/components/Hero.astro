---
import { getSite } from '@utils/siteData'

interface Props {
  title?: string
  description?: string
  primaryHref?: string
  primaryLabel?: string
  secondaryHref?: string
  secondaryLabel?: string
}

const site = getSite()
const {
  title = site.name,
  description = site.homepage.hero,
  primaryHref = '/events',
  primaryLabel = 'View Events',
  secondaryHref = '/get-involved',
  secondaryLabel = 'Get involved',
} = Astro.props
---

<section class="hero">
  <div class="container">
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="hero-actions">
      <a class="button button-light" href={primaryHref}>{primaryLabel}</a>
      <a class="button button-ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
