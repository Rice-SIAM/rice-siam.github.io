---
interface Props {
  title?: string
  description?: string
  primaryHref?: string
  primaryLabel?: string
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  title = 'Rice University SIAM Student Chapter',
  description = 'A student community for applied mathematics, computational science, scientific computing, and related fields at Rice University.',
  primaryHref = '/events',
  primaryLabel = 'View Events',
  secondaryHref = '/join',
  secondaryLabel = 'Join Rice SIAM',
} = Astro.props
---

<section class="hero">
  <div class="container">
    <h1>{title}</h1>
    <p>{description}</p>
    <div class="hero-actions">
      <a class="button button-light" href={primaryHref}>{primaryLabel}</a>
      <a class="button button-ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>
</section>
