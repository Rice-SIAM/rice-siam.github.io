---
import { Link } from 'accessible-astro-components'
import themeConfig from '@theme-config'

const label = themeConfig.shortName ?? themeConfig.name
---

<Link href="/" class="site-identity">
  <span class="site-identity-mark">
    <img
      class="brand-mark brand-mark-light"
      src="/images/branding/rice/logo-rice-blue.svg"
      alt=""
      width="110"
      height="40"
    />
    <img
      class="brand-mark brand-mark-dark"
      src="/images/branding/rice/logo-rice-white.svg"
      alt=""
      width="110"
      height="40"
    />
  </span>
  <span class="site-identity-name">{label}</span>
</Link>
