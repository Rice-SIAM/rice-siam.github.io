---
import { Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import themeConfig from '@theme-config'

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'

function isCurrentHref(href: string, external?: boolean) {
  if (external || !href.startsWith('/')) return false
  const itemPath = href.replace(/\/$/, '') || '/'
  return itemPath === currentPath || (itemPath !== '/' && currentPath.startsWith(`${itemPath}/`))
}
---

<ul class="menu">
  {
    themeConfig.navigation.items.map((item) => (
      <li
        class={`menu-item ${item.type === 'dropdown' ? 'has-dropdown' : ''} ${'highlight' in item && item.highlight ? 'highlight' : ''}`}
      >
        {item.type === 'dropdown' ? (
          <button aria-haspopup="true" aria-expanded="false">
            {item.label}
            <Icon aria-hidden="true" name="lucide:chevron-down" size="32" />
          </button>
        ) : (
          <Link
            href={item.href}
            isExternal={item.external ?? false}
            class={isCurrentHref(item.href, item.external) ? 'is-active' : undefined}
            aria-current={isCurrentHref(item.href, item.external) ? 'page' : undefined}
          >
            {item.label}
          </Link>
        )}
        {item.type === 'dropdown' && (
          <ul class="dropdown-menu">
            {item.items.map((subItem) => (
              <li class="submenu-item">
                <Link href={subItem.href} isExternal={subItem.external ?? false}>
                  {subItem.label}
                </Link>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
