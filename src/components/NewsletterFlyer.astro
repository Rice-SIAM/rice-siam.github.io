---
import { Heading, Link } from 'accessible-astro-components'
import RiceWordmark from './RiceWordmark.astro'
import SiamWordmark from './SiamWordmark.astro'
import { formatEventParts, formatEventDateRange } from '@utils/events'
import { formatDeadline } from '@utils/opportunities'
import { eventWhenWhere, isHttpUrl, type NewsletterData } from '@utils/newsletter'

interface Props {
  data: NewsletterData
}

const { data } = Astro.props
const { site, issue, featured, events, internships, jobs, fellowships, follow } = data
const contactHref = site.contactEmail ? `mailto:${site.contactEmail}` : '/contact'
const contactLabel = site.contactEmail ?? 'Contact the chapter'
const headline = issue.headline ?? `Your newsletter from ${site.shortName}`
const semesterTitle = issue.semesterTitle
---

<article class="flyer">
  <div class="flyer-deco" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <span class="blob blob-c"></span>
    <span class="blob blob-d"></span>
    <img class="owl owl-1" src="/images/branding/rice/owl-flat-blue.svg" alt="" width="96" height="96" />
    <img class="owl owl-2" src="/images/branding/rice/owl-flat-blue.svg" alt="" width="72" height="72" />
    <img class="owl owl-3" src="/images/branding/rice/owl-flat-blue.svg" alt="" width="64" height="64" />
  </div>

  <header class="flyer-top">
    <p class="flyer-brand">{site.shortName}</p>
    <ul class="flyer-marks">
      <li><RiceWordmark variant="on-light" /></li>
      <li><SiamWordmark variant="on-light" /></li>
    </ul>
    <p class="flyer-issue">
      <span class="flyer-issue-kicker">Issue {issue.issue}</span>
      <span class="flyer-issue-month">{issue.month}</span>
    </p>
  </header>

  <Heading level="h1" class="flyer-title">{headline}</Heading>

  {
    issue.greeting || issue.intro ? (
      <div class="flyer-lede">
        {issue.greeting ? <p class="flyer-greeting">{issue.greeting}</p> : null}
        {issue.intro ? <p>{issue.intro}</p> : null}
      </div>
    ) : null
  }

  <section class="card card-feature">
    {featured.kicker ? <p class="feature-kicker">{featured.kicker}</p> : null}
    <Heading level="h2">{featured.title}</Heading>
    {
      featured.when ? (
        <p class="feature-when">{featured.location ? `${featured.when} · ${featured.location}` : featured.when}</p>
      ) : null
    }
    <p>{featured.summary}</p>
    {
      featured.href && featured.hrefLabel ? (
        <p>
          <Link href={featured.href} isExternal={isHttpUrl(featured.href)}>
            {featured.hrefLabel}
          </Link>
        </p>
      ) : null
    }
    {
      featured.registrationUrl ? (
        <p>
          <Link href={featured.registrationUrl} isExternal={isHttpUrl(featured.registrationUrl)}>
            Registration details
          </Link>
        </p>
      ) : null
    }
  </section>

  <section class="card card-calendar">
    <Heading level="h2">{semesterTitle}</Heading>
    {
      events.length === 0 ? (
        <p>No upcoming events are listed.</p>
      ) : (
        <ol class="semester-list">
          {events.map((event, index) => {
            const parts = formatEventParts(event.data.start, event.data.allDay)
            const dateLabel = formatEventDateRange(event.data.start, event.data.end, event.data.allDay)
            const featuredRow = featured.eventId === event.id
            return (
              <li class:list={['semester-item', featuredRow && 'is-next', `tone-${(index % 4) + 1}`]}>
                <p class="semester-date">
                  <time datetime={event.data.start.toISOString()}>
                    <span class="semester-month">{parts.month}</span>
                    <span class="semester-day">{parts.day}</span>
                    <span class="sr-only">{dateLabel}</span>
                  </time>
                </p>
                <div class="semester-body">
                  <Heading level="h3" size="h6">
                    <Link href={`/events/${event.id}`}>{event.data.title}</Link>
                  </Heading>
                  <p class="semester-summary">{event.data.summary}</p>
                  <p class="semester-meta">{eventWhenWhere(event)}</p>
                  {event.data.registrationUrl ? (
                    <p>
                      <Link href={event.data.registrationUrl} isExternal={isHttpUrl(event.data.registrationUrl)}>
                        Registration details
                      </Link>
                    </p>
                  ) : null}
                </div>
              </li>
            )
          })}
        </ol>
      )
    }
    <p class="card-more">
      <Link href="/events">All events</Link>
    </p>
  </section>

  {
    issue.meetings && issue.meetings.items.length > 0 ? (
      <section class="card card-meetings">
        <Heading level="h2">{issue.meetings.title}</Heading>
        <ul>
          {issue.meetings.items.map((meeting) => (
            <li>
              <Heading level="h3" size="h6">
                <Link href={meeting.href} isExternal={isHttpUrl(meeting.href)}>
                  {meeting.title}
                </Link>
              </Heading>
              {meeting.when ? (
                <p class="semester-meta">{meeting.location ? `${meeting.when} · ${meeting.location}` : meeting.when}</p>
              ) : meeting.location ? (
                <p class="semester-meta">{meeting.location}</p>
              ) : null}
              {meeting.note ? <p>{meeting.note}</p> : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <div class="flyer-grid">
    <section class="card card-internships">
      <Heading level="h2">Internships</Heading>
      {
        internships.length === 0 ? (
          <p>No internships are listed.</p>
        ) : (
          <ul>
            {internships.map((opportunity) => (
              <li>
                <Heading level="h3" size="h6">
                  <Link href={opportunity.data.url} isExternal>
                    {opportunity.data.title}
                  </Link>
                </Heading>
                <p>{opportunity.data.organization}</p>
                {opportunity.data.deadline ? (
                  <p>
                    <time datetime={opportunity.data.deadline.toISOString()}>
                      Apply by {formatDeadline(opportunity.data.deadline)}.
                    </time>
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        )
      }
      <p class="card-more">
        <Link href="/opportunities">All opportunities</Link>
      </p>
    </section>

    <section class="card card-jobs">
      <Heading level="h2">Jobs</Heading>
      {
        jobs.length === 0 ? (
          <p>No jobs are listed.</p>
        ) : (
          <ul>
            {jobs.map((opportunity) => (
              <li>
                <Heading level="h3" size="h6">
                  <Link href={opportunity.data.url} isExternal>
                    {opportunity.data.title}
                  </Link>
                </Heading>
                <p>{opportunity.data.organization}</p>
                {opportunity.data.deadline ? (
                  <p>
                    <time datetime={opportunity.data.deadline.toISOString()}>
                      Apply by {formatDeadline(opportunity.data.deadline)}.
                    </time>
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        )
      }
      <p class="card-more">
        <Link href="/opportunities">All opportunities</Link>
      </p>
    </section>

    <section class="card card-fellowships">
      <Heading level="h2">Fellowships</Heading>
      {
        fellowships.length === 0 ? (
          <p>No fellowships are listed.</p>
        ) : (
          <ul>
            {fellowships.map((opportunity) => (
              <li>
                <Heading level="h3" size="h6">
                  <Link href={opportunity.data.url} isExternal>
                    {opportunity.data.title}
                  </Link>
                </Heading>
                <p>{opportunity.data.organization}</p>
                {opportunity.data.deadline ? (
                  <p>
                    <time datetime={opportunity.data.deadline.toISOString()}>
                      Apply by {formatDeadline(opportunity.data.deadline)}.
                    </time>
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        )
      }
      <p class="card-more">
        <Link href="/opportunities">All opportunities</Link>
      </p>
    </section>
  </div>

  {
    follow ? (
      <section class="card card-accent">
        <Heading level="h2">{follow.title}</Heading>
        {follow.body ? <p>{follow.body}</p> : null}
        {follow.items.length > 0 ? (
          <ul>
            {follow.items.map((item) => (
              <li>
                <Link href={item.href} isExternal={isHttpUrl(item.href)}>
                  {item.label}
                </Link>
                {item.note ? <p>{item.note}</p> : null}
              </li>
            ))}
          </ul>
        ) : null}
      </section>
    ) : null
  }

  <div class="flyer-grid">
    {
      issue.notes.map((note) => (
        <section class="card card-light">
          <Heading level="h2">{note.title}</Heading>
          {note.body ? <p>{note.body}</p> : null}
          {note.href && note.hrefLabel ? (
            <p>
              <Link href={note.href} isExternal={isHttpUrl(note.href)}>
                {note.hrefLabel}
              </Link>
            </p>
          ) : null}
        </section>
      ))
    }
  </div>

  {
    issue.resources ? (
      <section class="card card-cta">
        <Heading level="h2">{issue.resources.title}</Heading>
        <ul>
          {issue.resources.items.map((item) => (
            <li>
              <Link href={item.href} isExternal={isHttpUrl(item.href)}>
                {item.label}
              </Link>
              {item.note ? <p>{item.note}</p> : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null
  }

  <footer class="flyer-foot">
    <p>
      <Link href="/">{site.name}</Link>
      {
        site.contactEmail ? (
          <>
            {' · '}
            <Link href={contactHref}>{contactLabel}</Link>
          </>
        ) : null
      }
      {' · Rice University, Houston, Texas'}
    </p>
  </footer>
</article>

<style lang="scss">
  .flyer {
    --flyer-navy: #00205b;
    --flyer-ink: #1c1c1c;
    --flyer-cream: #fff8f0;
    --flyer-paper: #ffffff;
    --flyer-line: #adc7dc;
    --flyer-bright: #9fddf9;
    --flyer-gold: #e9a139;
    --flyer-mint: #6bd0c2;
    --flyer-burgundy: #68132e;
    --flyer-emerald: #005b50;
    --flyer-midnight: #13133e;
    --flyer-wash: #fff4ea;
    --flyer-brick: #c04829;

    position: relative;
    margin: 1.25rem auto;
    box-shadow: inset 0 0 0 6px var(--flyer-gold);
    border: 0.7rem solid var(--flyer-navy);
    border-radius: 1.25rem;
    background-color: var(--flyer-wash);
    isolation: isolate;
    padding: 1.5rem 1.25rem 1.25rem;
    max-width: 54rem;
    overflow: hidden;
    color: var(--flyer-ink);
  }

  .flyer-deco {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    opacity: 0.75;
    border-radius: 50%;
  }

  .blob-a {
    top: -3rem;
    left: -2rem;
    background: var(--flyer-bright);
    width: 11rem;
    height: 11rem;
  }

  .blob-b {
    top: -2rem;
    right: 22%;
    background: var(--flyer-gold);
    width: 7rem;
    height: 7rem;
  }

  .blob-c {
    right: -2.5rem;
    bottom: 28%;
    background: var(--flyer-mint);
    width: 9rem;
    height: 9rem;
  }

  .blob-d {
    bottom: -2rem;
    left: 18%;
    opacity: 0.55;
    background: var(--flyer-brick);
    width: 8rem;
    height: 8rem;
  }

  .owl {
    position: absolute;
    opacity: 0.18;
  }

  .owl-1 {
    top: 7.5rem;
    left: 0.35rem;
  }

  .owl-2 {
    right: 0.5rem;
    bottom: 8rem;
  }

  .owl-3 {
    bottom: 1.25rem;
    left: 42%;
  }

  .flyer-top {
    display: grid;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1.25rem;
  }

  .flyer-brand {
    margin: 0;
    color: var(--flyer-navy);
    font-weight: 700;
    font-size: 1.65rem;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .flyer-marks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flyer-issue {
    display: grid;
    justify-items: start;
    margin: 0;
    border: 3px solid var(--flyer-navy);
    border-radius: 3.15rem 1.4rem 3.15rem 1.4rem;
    background-color: var(--flyer-paper);
    padding: 0.5rem 1.35rem;
    max-width: max-content;
    color: var(--flyer-navy);
    font-weight: 700;
    line-height: 1.2;
  }

  .flyer-issue-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flyer-issue-month {
    font-size: 0.95rem;
  }

  .flyer-title {
    margin: 0.25rem 0 1rem;
    color: var(--flyer-navy);
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  .flyer-lede {
    margin: 0 auto 1rem;
    max-width: 38rem;
    text-align: center;
  }

  .flyer-greeting {
    margin: 0 0 0.35rem;
    color: var(--flyer-navy);
    font-weight: 700;
  }

  .flyer-grid {
    display: grid;
    gap: 1rem;
    margin-block: 1rem;
  }

  .card {
    border-radius: 1.15rem;
    padding: 1rem 1.1rem;

    h2 {
      margin: 0 0 0.65rem;
      font-size: 1.2rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    h3 {
      margin: 0;

      :global(a) {
        overflow-wrap: anywhere;
      }
    }

    p,
    li {
      font-size: 0.98rem;
      line-height: 1.45;
    }

    ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    li + li {
      margin-block-start: 0.75rem;
      border-top: 1px solid #e0e2e6;
      padding-block-start: 0.75rem;
    }

    .card-more {
      margin-block-start: 0.85rem;
    }
  }

  .card-feature {
    margin: 0 auto 1rem;
    border: 3px solid var(--flyer-gold);
    background: linear-gradient(180deg, #fff7d6 0%, #fff4ea 70%);
    padding: 1.1rem 1.25rem;
    max-width: 38rem;
    text-align: center;

    h2,
    p,
    a {
      color: var(--flyer-navy);
    }
  }

  .feature-kicker {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .feature-when {
    font-weight: 700;
  }

  .card-calendar {
    border: 3px solid var(--flyer-navy);
    background: linear-gradient(180deg, #f3fbff 0%, var(--flyer-paper) 55%);

    h2 {
      color: var(--flyer-navy);
      text-align: center;
    }
  }

  .semester-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .semester-item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.85rem;
    border: 1px solid var(--flyer-line);
    border-radius: 1.25rem;
    background-color: #f4f7fb;
    padding: 0.75rem 0.85rem;
  }

  .semester-item.is-next {
    border-color: var(--flyer-gold);
    background-color: #fff4ea;
  }

  .semester-date {
    display: grid;
    justify-items: center;
    margin: 0;
    border-radius: 999px;
    background-color: var(--flyer-navy);
    padding: 0.55rem 0.7rem;
    min-width: 4.4rem;
    color: var(--flyer-paper);
    line-height: 1.05;
    text-align: center;
  }

  .tone-1 .semester-date {
    background-color: var(--flyer-navy);
    color: var(--flyer-paper);
  }

  .tone-2 .semester-date {
    background-color: var(--flyer-burgundy);
    color: var(--flyer-paper);
  }

  .tone-3 .semester-date {
    background-color: var(--flyer-emerald);
    color: var(--flyer-paper);
  }

  .tone-4 .semester-date {
    background-color: var(--flyer-gold);
    color: var(--flyer-navy);
  }

  .semester-month {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .semester-day {
    font-weight: 700;
    font-size: 1.45rem;
  }

  .semester-body {
    min-width: 0;
  }

  .semester-summary {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }

  .semester-meta {
    margin: 0.15rem 0 0;
  }

  .card-internships {
    border: 3px solid var(--flyer-emerald);
    background: linear-gradient(180deg, #e5f7f3 0%, var(--flyer-paper) 40%);

    h2 {
      color: var(--flyer-emerald);
    }
  }

  .card-jobs {
    border: 3px solid var(--flyer-gold);
    background: linear-gradient(180deg, #fff4d6 0%, var(--flyer-paper) 40%);

    h2 {
      color: var(--flyer-navy);
    }
  }

  .card-fellowships {
    border: 3px solid #0a509e;
    background: linear-gradient(180deg, #e4eef9 0%, var(--flyer-paper) 40%);

    h2 {
      color: #0a509e;
    }
  }

  .card-meetings {
    margin-block: 1rem;
    border: 3px solid var(--flyer-burgundy);
    background: linear-gradient(180deg, #fdecef 0%, var(--flyer-paper) 45%);

    h2 {
      color: var(--flyer-burgundy);
    }
  }

  .card-light {
    border: 2px solid var(--flyer-navy);
    background-color: var(--flyer-paper);

    h2 {
      color: var(--flyer-navy);
    }
  }

  .card-accent {
    margin-block: 1rem;
    border: 3px solid var(--flyer-bright);
    background: linear-gradient(180deg, #e7f7fe 0%, var(--flyer-paper) 50%);

    h2 {
      color: var(--flyer-navy);
    }
  }

  .card-cta {
    margin-block: 1rem;
    background-color: var(--flyer-emerald);
    color: var(--flyer-paper);

    h2,
    p {
      color: var(--flyer-paper);
    }

    :global(a:not(.button)) {
      color: var(--flyer-paper);
      text-decoration-color: var(--flyer-paper);

      &:where(:hover, :focus-visible) {
        color: #e0e2e6;
        text-decoration-color: #e0e2e6;
      }
    }

    li + li {
      border-top-color: rgb(255 255 255 / 0.28);
    }
  }

  .flyer-foot {
    margin-block-start: 0.5rem;
    border-radius: 0 0 1rem 1rem;
    background-color: var(--flyer-midnight);
    padding: 0.75rem 1rem;
    color: var(--flyer-paper);
    text-align: center;

    p {
      margin: 0;
      font-size: 0.92rem;
    }

    :global(a:not(.button)) {
      color: var(--flyer-bright);
      text-decoration-color: var(--flyer-bright);

      &:where(:hover, :focus-visible) {
        color: var(--flyer-paper);
        text-decoration-color: var(--flyer-paper);
      }
    }
  }

  @media (min-width: 48rem) {
    .flyer {
      padding: 1.75rem 1.75rem 1.5rem;
    }

    .flyer-top {
      grid-template-columns: minmax(8rem, 1fr) auto minmax(8rem, auto);
      gap: 1rem;
    }

    .flyer-brand {
      font-size: 1.9rem;
    }

    .flyer-issue {
      justify-self: end;
    }

    .flyer-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;

      > :last-child:nth-child(odd) {
        grid-column: 1 / -1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flyer * {
      transition: none;
    }
  }

  @media (prefers-contrast: more) {
    .flyer {
      border-color: #000000;
      background-color: var(--flyer-paper);
    }

    .blob,
    .owl {
      display: none;
    }

    .card-feature,
    .card-light,
    .card-accent,
    .card-calendar,
    .card-internships,
    .card-jobs,
    .card-fellowships,
    .card-meetings,
    .flyer-issue,
    .semester-item {
      border-color: #000000;
      background: var(--flyer-paper);
    }

    .semester-date,
    .card-cta,
    .flyer-foot {
      background-color: #000000;
      color: #ffffff;
    }

    .tone-4 .semester-date {
      background-color: #000000;
      color: #ffffff;
    }
  }

  @media print {
    .flyer {
      margin: 0 auto;
      box-shadow: none;
    }

    .card,
    .flyer-foot,
    .card-feature,
    .semester-item {
      break-inside: avoid;
    }
  }
</style>
