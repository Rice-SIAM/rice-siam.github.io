---
import OfficerCard from './OfficerCard.astro'
import { getOfficers, type Officer } from '@utils/siteData'

interface Props {
  officers?: Officer[]
  headingLevel?: 'h2' | 'h3'
  limit?: number
}

const { officers = getOfficers(), headingLevel = 'h3', limit } = Astro.props
const displayed = typeof limit === 'number' ? officers.slice(0, limit) : officers
---

{
  displayed.length === 0 ? (
    <div class="empty-state">
      <p>Leadership information will appear here when it is added to the officer roster.</p>
    </div>
  ) : (
    <ul class="officer-list">
      {displayed.map((officer) => (
        <li>
          <OfficerCard officer={officer} headingLevel={headingLevel} />
        </li>
      ))}
    </ul>
  )
}
