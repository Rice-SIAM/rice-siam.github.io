---
import { Heading, Link } from 'accessible-astro-components'
import { formatDeadline, type OpportunityEntry } from '@utils/opportunities'

interface Props {
  opportunity: OpportunityEntry
  headingLevel?: 'h2' | 'h3'
}

const { opportunity, headingLevel = 'h3' } = Astro.props
const { title, organization, location, audience, url, summary, deadline } = opportunity.data
const meta = [organization, location, audience].filter(Boolean).join(' · ')
---

<article class="opportunity-card">
  <Heading level={headingLevel} size="h4">
    <Link href={url} isExternal>{title}</Link>
  </Heading>
  {meta && <p class="event-meta">{meta}</p>}
  <p>{summary}</p>
  {
    deadline && (
      <p class="event-meta">
        <time datetime={deadline.toISOString()}>Apply by {formatDeadline(deadline)}</time>
      </p>
    )
  }
</article>
