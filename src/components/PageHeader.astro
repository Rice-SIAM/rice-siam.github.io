---
import { Breadcrumbs, BreadcrumbsItem, Heading } from 'accessible-astro-components'

interface Props {
  title: string
  subtitle?: string
  showBreadcrumbs?: boolean
  customBreadcrumbLabels?: Record<string, string>
}

const { title, subtitle, showBreadcrumbs = true, customBreadcrumbLabels } = Astro.props

const formatSegment = (segment: string): string => {
  if (customBreadcrumbLabels?.[segment]) {
    return customBreadcrumbLabels[segment]
  }
  return segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
}

const path = Astro.url.pathname
const segments = path.split('/').filter(Boolean)
---

<section class="page-header">
  <div class="container">
    {
      showBreadcrumbs && segments.length > 0 && (
        <Breadcrumbs>
          <BreadcrumbsItem href="/" label="Home" />
          {segments.map((segment, index) => {
            const url = `/${segments.slice(0, index + 1).join('/')}`
            const isLast = index === segments.length - 1
            return (
              <BreadcrumbsItem href={isLast ? undefined : url} label={formatSegment(segment)} currentPage={isLast} />
            )
          })}
        </Breadcrumbs>
      )
    }
    <Heading level="h1">{title}</Heading>
    {subtitle && <p class="lede">{subtitle}</p>}
  </div>
</section>
