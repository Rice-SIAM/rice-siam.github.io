---
import { Heading, Link } from 'accessible-astro-components'
import { getPartners, type Partner } from '@utils/siteData'

interface Props {
  partners?: Partner[]
  emptyMessage?: string
}

const {
  partners = getPartners(),
  emptyMessage = 'No partners are listed.',
} = Astro.props
---

{
  partners.length === 0 ? (
    <p>{emptyMessage}</p>
  ) : (
    <ul class="partner-list">
      {partners.map((partner) => (
        <li>
          <article class="partner-card">
            {partner.logo && (
              <img src={partner.logo} alt={partner.logoAlt ?? ''} width="160" height="80" class="partner-logo" />
            )}
            <Heading level="h3" size="h5">
              {partner.url ? (
                <Link href={partner.url} isExternal>
                  {partner.name}
                </Link>
              ) : (
                partner.name
              )}
            </Heading>
            {partner.description && <p>{partner.description}</p>}
          </article>
        </li>
      ))}
    </ul>
  )
}
