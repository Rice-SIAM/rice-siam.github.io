---
import { Heading } from 'accessible-astro-components'

interface Props {
  title: string
  description?: string
  centered?: boolean
}

const { title, description, centered = false } = Astro.props
---

<div class:list={['section-heading', { 'is-centered': centered }]}>
  <Heading level="h2">{title}</Heading>
  {description && <p>{description}</p>}
</div>
