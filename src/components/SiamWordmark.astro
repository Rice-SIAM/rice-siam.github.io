---
import { Link } from 'accessible-astro-components'

interface Props {
  variant?: 'on-light' | 'on-dark'
}

const { variant = 'on-dark' } = Astro.props
const src =
  variant === 'on-dark'
    ? '/images/branding/siam/logo-siam-white.png'
    : '/images/branding/siam/logo-siam-blue.png'
---

<Link
  href="https://www.siam.org"
  isExternal
  hideIcon
  class="siam-wordmark"
  ariaLabel="Society for Industrial and Applied Mathematics"
>
  <img src={src} alt="" width="100" height="32" />
</Link>
