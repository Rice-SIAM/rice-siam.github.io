---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import themeConfig from '@theme-config'
import { SEO } from 'astro-seo'
import { SkipLink } from 'accessible-astro-components'

interface Props {
  title: string
  description: string
  bodyClass?: string
}

const { title, description, bodyClass = 'flyer-body' } = Astro.props
const canonical = Astro.url.href
---

<html lang="en" dir="ltr" data-flyer>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />

    <SEO
      title={title}
      titleTemplate={`%s - ${themeConfig.seo.title}`}
      titleDefault={themeConfig.seo.title}
      description={description}
      canonical={canonical}
      noindex
      nofollow
      openGraph={{
        basic: {
          title,
          type: 'article',
          image: new URL('/favicon.svg', Astro.site).href,
          url: canonical,
        },
        optional: {
          description,
        },
      }}
      extend={{
        meta: [{ name: 'author', content: themeConfig.seo.author ?? '' }],
      }}
    />
  </head>
  <body class={bodyClass}>
    <SkipLink />
    <main id="main-content">
      <slot />
    </main>
    <style lang="scss" is:global>
      html[data-flyer] {
        color-scheme: light;
      }

      .flyer-body,
      .email-body {
        min-height: 100%;
        color: #1c1c1c;
      }

      .flyer-body {
        background-color: #e0e2e6;
      }

      .email-body {
        background-color: #ffffff;
      }

      .flyer-body .skip-link a,
      .email-body .skip-link a {
        position: absolute;
        transform: translateY(calc(-100% - 2rem));
        z-index: var(--z-index-10);
        inset-block-start: var(--space-s);
        inset-inline-start: var(--space-s);
        background-color: #ffffff;
        padding: var(--space-2xs) var(--space-s);
        color: #00205b;

        &:focus,
        &:focus-visible {
          transform: none;
        }
      }

      @media print {
        .flyer-body .skip-link,
        .email-body .skip-link {
          display: none;
        }

        .flyer-body,
        .email-body {
          background-color: #ffffff;
        }
      }
    </style>
  </body>
</html>
