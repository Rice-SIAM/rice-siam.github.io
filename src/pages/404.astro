---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
---

<DefaultLayout title="Page not found" description="The requested page could not be found.">
  <PageHeader title="Page not found" subtitle="The page you requested is not available." showBreadcrumbs={false} />
  <section class="site-section">
    <div class="container">
      <p class="prose-narrow">You can return to the homepage or browse the main sections of the site.</p>
      <p class="section-footer">
        <a class="button button-navy" href="/">Back to the homepage</a>
      </p>
    </div>
  </section>
</DefaultLayout>
