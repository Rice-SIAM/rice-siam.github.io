---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Link } from 'accessible-astro-components'
---

<DefaultLayout title="Page not found" description="The requested page could not be found.">
  <section class="my-12">
    <div class="container">
      <Heading level="h1">Page not found</Heading>
    </div>
  </section>
  <section class="my-12">
    <div class="space-content container">
      <p class="text-2xl">The page you requested is not available. You can return to the homepage or browse the main sections of the site.</p>
      <Link href="/" isButton type="primary">
        Back to the homepage
      </Link>
    </div>
  </section>
</DefaultLayout>
