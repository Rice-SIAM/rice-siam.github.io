---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import ConferenceList from '@components/ConferenceList.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
import { getUpcomingConferences } from '@utils/conferences'

const conferences = await getUpcomingConferences()
---

<DefaultLayout
  title="Conferences"
  description="Workshops and conferences in applied mathematics and computational science."
>
  <PageHeader
    title="Conferences"
    subtitle="Workshops and conferences in applied mathematics and computational science."
  >
    <p>
      See also
      <Link href="https://www.siam.org/conferences-events/" isExternal>SIAM conferences and events</Link>.
    </p>
  </PageHeader>

  <Section>
    <SectionHeading title="Upcoming" />
    <ConferenceList conferences={conferences} headingLevel="h3" emptyMessage="No upcoming conferences are listed." />
  </Section>
</DefaultLayout>
