---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getSite } from '@utils/siteData'

const site = getSite()
---

<DefaultLayout
  title="Contact"
  description="Public contact information for the Rice University SIAM Student Chapter."
>
  <PageHeader
    title="Contact"
    subtitle="Reach the Rice University SIAM Student Chapter through the public channels listed below."
    bgType="bordered"
  />
  <section class="my-16">
    <div class="space-content narrow container">
      <Heading level="h2">Public channels</Heading>
      <p>
        A public chapter email address will be added here when it is available. Until then, the best public contact
        point is the chapter GitHub organization.
      </p>
      <p>
        <Link href={site.github} isExternal>Rice SIAM on GitHub</Link>
      </p>
      <p>
        For accessibility feedback about this website, see the
        <Link href="/accessibility-statement">accessibility statement</Link>.
      </p>
      <Heading level="h2">What not to expect yet</Heading>
      <p>
        This page does not currently list a phone number, mailing address, or office hours. Those details will appear
        only when they are confirmed.
      </p>
    </div>
  </section>
</DefaultLayout>
