---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
import { getSite } from '@utils/siteData'

const site = getSite()
---

<DefaultLayout
  title="Contact"
  description="Public contact information for the Rice University SIAM Student Chapter."
>
  <PageHeader
    title="Contact"
    subtitle="Reach the Rice University SIAM Student Chapter through the public channels listed below."
  />
  <Section narrow>
    <SectionHeading title="Public channels" />
    <div class="space-content">
      {
        site.contactEmail ? (
          <p>
            <Link href={`mailto:${site.contactEmail}`}>{site.contactEmail}</Link>
          </p>
        ) : (
          <p>A public chapter email address will be added here when it is available.</p>
        )
      }
      <p>
        <Link href={site.github} isExternal>Rice SIAM on GitHub</Link>
      </p>
      <p>
        For accessibility feedback about this website, see the
        <Link href="/accessibility-statement">accessibility statement</Link>.
      </p>
    </div>
  </Section>
</DefaultLayout>
