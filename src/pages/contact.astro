---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import Section from '@components/Section.astro'
import { Link } from 'accessible-astro-components'
import { getSite } from '@utils/siteData'

const site = getSite()
---

<DefaultLayout title="Contact" description="Public contact information for the Rice University SIAM Student Chapter.">
  <PageHeader title="Contact" />
  <Section narrow>
    <div class="space-content">
      {
        site.contactEmail && (
          <p>
            <Link href={`mailto:${site.contactEmail}`}>{site.contactEmail}</Link>
          </p>
        )
      }
      <p>
        For accessibility feedback about this website, see the
        <Link href="/accessibility-statement">accessibility statement</Link>.
      </p>
    </div>
  </Section>
</DefaultLayout>
