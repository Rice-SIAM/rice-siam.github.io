---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import Section from '@components/Section.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getCollection, render } from 'astro:content'
import { eventIcsPath, googleEventUrl } from '@utils/calendar'
import { formatEventDateRange, isEventPast } from '@utils/events'

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft)
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }))
}

const { event } = Astro.props
const { Content } = await render(event)
const { title, start, end, location, summary, registrationUrl, image, imageAlt, allDay } = event.data
const showActions = !isEventPast(event)
const origin = Astro.site ?? new URL(Astro.url.origin)
const googleCalendarUrl = googleEventUrl(event, origin)
---

<DefaultLayout title={title} description={summary} type="article">
  <PageHeader title={title} subtitle={summary} />
  <Section narrow>
    <article class="space-content">
      {image && <img src={image} alt={imageAlt ?? ''} width="1200" height="630" class="event-image" />}
      <Heading level="h2">Details</Heading>
      <p>
        <strong>When:</strong>
        <time datetime={start.toISOString()}>{formatEventDateRange(start, end, allDay)}</time>
      </p>
      {
        location && (
          <p>
            <strong>Where:</strong> {location}
          </p>
        )
      }
      {
        showActions && (
          <p>
            <Link href={`/events/${event.id}/flyer`}>Printable flyer</Link>
          </p>
        )
      }
      {
        showActions && registrationUrl && (
          <p>
            <Link href={registrationUrl} isExternal>
              Registration details
            </Link>
          </p>
        )
      }
      {
        showActions && (
          <p>
            <Link href={googleCalendarUrl} isExternal>
              Add {title} to Google Calendar
            </Link>
          </p>
        )
      }
      {
        showActions && (
          <p>
            <Link href={eventIcsPath(event.id)}>Download {title} calendar file</Link>
          </p>
        )
      }
      <Content />
    </article>
  </Section>
</DefaultLayout>
