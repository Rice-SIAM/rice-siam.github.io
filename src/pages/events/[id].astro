---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import Section from '@components/Section.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getCollection, render } from 'astro:content'
import { formatEventDateRange } from '@utils/events'

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft)
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }))
}

const { event } = Astro.props
const { Content } = await render(event)
const { title, start, end, location, summary, registrationUrl, calendarUrl, image, imageAlt } = event.data
---

<DefaultLayout title={title} description={summary} type="article">
  <PageHeader title={title} subtitle={summary} />
  <Section narrow>
    <article class="space-content">
      {image && <img src={image} alt={imageAlt ?? ''} width="1200" height="630" class="event-image" />}
      <Heading level="h2">Details</Heading>
      <p>
        <strong>When:</strong>
        <time datetime={start.toISOString()}>{formatEventDateRange(start, end)}</time>
      </p>
      {
        location && (
          <p>
            <strong>Where:</strong> {location}
          </p>
        )
      }
      {
        registrationUrl && (
          <p>
            <Link href={registrationUrl} isExternal>
              Registration details
            </Link>
          </p>
        )
      }
      {
        calendarUrl && (
          <p>
            <Link href={calendarUrl} isExternal>
              Add to calendar
            </Link>
          </p>
        )
      }
      <Content />
    </article>
  </Section>
</DefaultLayout>
