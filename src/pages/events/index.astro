---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import PageContents from '@components/PageContents.astro'
import CalendarSubscribe from '@components/CalendarSubscribe.astro'
import EventList from '@components/EventList.astro'
import EventHistory from '@components/EventHistory.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
import { getUpcomingEvents, getPastEvents, groupEventsByAcademicYear } from '@utils/events'

const upcomingEvents = await getUpcomingEvents()
const pastEventYears = groupEventsByAcademicYear(await getPastEvents())

function eventCountLabel(count: number): string {
  return count === 1 ? '1 event' : `${count} events`
}

const contentsItems = [
  { href: '#upcoming', label: `Upcoming (${eventCountLabel(upcomingEvents.length)})` },
  { href: '#calendar', label: 'Chapter calendar' },
  ...(pastEventYears.length > 0
    ? [
        {
          href: '#past-events',
          label: 'Past events',
          children: pastEventYears.map((group) => ({
            href: `#${group.yearId}`,
            label: `${group.term} (${eventCountLabel(group.events.length)})`,
          })),
        },
      ]
    : []),
]
---

<DefaultLayout
  title="Events"
  description="Upcoming and past events hosted by the Rice University SIAM Student Chapter."
  calendarFeed
>
  <PageHeader title="Events" subtitle="Talks, workshops, and other chapter activities.">
    <p>
      The chapter often meets around CMOR
      <Link href="https://cmor.rice.edu/news-events/colloquia" isExternal>colloquia</Link>
      and
      <Link href="https://rtg-nasc.rice.edu/" isExternal>NASC seminars</Link>.
    </p>
    <PageContents headingId="events-contents-heading" items={contentsItems} />
  </PageHeader>

  <Section id="upcoming">
    <SectionHeading title="Upcoming" />
    <EventList events={upcomingEvents} headingLevel="h3" />
    <CalendarSubscribe />
  </Section>

  {
    pastEventYears.length > 0 && (
      <Section muted id="past-events">
        <SectionHeading title="Past events" />
        <EventHistory groups={pastEventYears} headingLevel="h3" />
      </Section>
    )
  }
</DefaultLayout>
