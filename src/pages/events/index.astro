---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import EventList from '@components/EventList.astro'
import { Heading } from 'accessible-astro-components'
import { getUpcomingEvents, getPastEvents } from '@utils/events'

const upcomingEvents = await getUpcomingEvents()
const pastEvents = await getPastEvents()
---

<DefaultLayout
  title="Events"
  description="Upcoming and past events hosted by the Rice University SIAM Student Chapter."
>
  <PageHeader
    title="Events"
    subtitle="Talks, workshops, and other chapter activities."
    bgType="bordered"
  />
  <section class="my-16">
    <div class="space-content container">
      <Heading level="h2">Upcoming</Heading>
      <EventList events={upcomingEvents} headingLevel="h3" />

      {
        pastEvents.length > 0 && (
          <>
            <Heading level="h2">Past events</Heading>
            <EventList
              events={pastEvents}
              headingLevel="h3"
              emptyMessage="No past events are listed yet."
            />
          </>
        )
      }
    </div>
  </section>
</DefaultLayout>
