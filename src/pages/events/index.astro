---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import EventList from '@components/EventList.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { getUpcomingEvents, getPastEvents } from '@utils/events'

const upcomingEvents = await getUpcomingEvents()
const pastEvents = await getPastEvents()
---

<DefaultLayout
  title="Events"
  description="Upcoming and past events hosted by the Rice University SIAM Student Chapter."
>
  <PageHeader title="Events" subtitle="Talks, workshops, and other chapter activities." />

  <Section>
    <SectionHeading title="Upcoming" />
    <EventList events={upcomingEvents} headingLevel="h3" />
  </Section>

  {
    pastEvents.length > 0 && (
      <Section muted>
        <SectionHeading title="Past events" />
        <EventList events={pastEvents} headingLevel="h3" emptyMessage="No past events are listed yet." />
      </Section>
    )
  }
</DefaultLayout>
