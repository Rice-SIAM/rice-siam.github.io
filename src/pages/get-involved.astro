---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
---

<DefaultLayout title="Get involved" description="How to take part in the Rice University SIAM Student Chapter.">
  <PageHeader title="Get involved" subtitle="Come to chapter events." />

  <Section narrow>
    <SectionHeading title="Who is welcome" />
    <p>
      Rice SIAM is for Rice University students interested in applied mathematics, computational science, scientific
      computing, and related fields. Undergraduate and graduate students are welcome, including students outside CMOR.
    </p>
  </Section>

  <Section muted narrow>
    <SectionHeading title="How to take part" />
    <div class="space-content">
      <ul>
        <li>
          Watch the <Link href="/events">events page</Link> and show up.
        </li>
        <li>
          If you want to help organize events or serve as an officer, use the
          <Link href="/contact">contact page</Link>.
        </li>
      </ul>
    </div>
  </Section>

  <Section narrow>
    <SectionHeading title="SIAM student membership" />
    <p>
      Chapter events do not require SIAM membership. Students in this chapter can get a free SIAM student membership.
      Apply on SIAM’s
      <Link href="https://www.siam.org/membership/individual-membership/student-membership/" isExternal>
        student membership page
      </Link>.
    </p>
  </Section>
</DefaultLayout>
