---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import EventList from '@components/EventList.astro'
import OfficerList from '@components/OfficerList.astro'
import PartnerList from '@components/PartnerList.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
import { getHomepageEvents } from '@utils/events'
import { getPartners, getSite } from '@utils/siteData'

const site = getSite()
const upcomingEvents = await getHomepageEvents()
const partners = getPartners()
---

<DefaultLayout title={site.seo.title} description={site.seo.description} useTitleTemplate={false}>
  <Hero />

  <Section>
    <SectionHeading title="About the chapter" centered />
    <p class="prose-narrow horizontal-center">
      {site.homepage.about}
      <Link href="/about">Learn more about the chapter</Link>
    </p>
  </Section>

  <Section muted>
    <SectionHeading title="Upcoming events" description="Talks, workshops, and other chapter activities." centered />
    <EventList events={upcomingEvents} headingLevel="h3" />
    <p class="section-footer">
      <Link href="/events">View all events</Link>
    </p>
  </Section>

  <Section>
    <SectionHeading
      title="Leadership"
      description="Current officers of the Rice University SIAM Student Chapter."
      centered
    />
    <OfficerList headingLevel="h3" limit={3} />
    <p class="section-footer">
      <Link href="/leadership">Meet the leadership team</Link>
    </p>
  </Section>

  {
    partners.length > 0 && (
      <Section>
        <SectionHeading title="Partners" description="Organizations we work with." centered />
        <PartnerList partners={partners} />
      </Section>
    )
  }
</DefaultLayout>
