---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import EventList from '@components/EventList.astro'
import OfficerList from '@components/OfficerList.astro'
import PartnerList from '@components/PartnerList.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
import { getHomepageEvents } from '@utils/events'
import { getPartners, getSite } from '@utils/siteData'

const site = getSite()
const upcomingEvents = await getHomepageEvents()
const partners = getPartners()
---

<DefaultLayout title={site.seo.title} description={site.seo.description} useTitleTemplate={false}>
  <Hero />

  <Section>
    <SectionHeading
      title="About the chapter"
      description="Rice SIAM is a student community for people interested in applied mathematics, computational science, scientific computing, and related fields at Rice University."
      centered
    />
    <p class="prose-narrow horizontal-center">
      We organize academic, professional, and social activities for undergraduate and graduate students.
      <Link href="/about">Learn more about the chapter</Link>
    </p>
  </Section>

  <Section muted>
    <SectionHeading title="Upcoming events" description="Talks, workshops, and other chapter activities." centered />
    <EventList events={upcomingEvents} headingLevel="h3" />
    <p class="section-footer">
      <Link href="/events">View all events</Link>
    </p>
  </Section>

  <Section>
    <SectionHeading
      title="Why get involved"
      description="Rice SIAM is a place to learn, meet peers, and take part in chapter events."
      centered
    />
    <div class="feature-grid">
      <Feature icon="lucide:book-open" title="Applied mathematics">
        Explore mathematical ideas used in science, engineering, and data-driven research.
      </Feature>
      <Feature icon="lucide:cpu" title="Computational science">
        Connect with students working on scientific computing, modeling, and computation.
      </Feature>
      <Feature icon="lucide:users" title="Student community">
        Meet peers, hear from speakers, and take part in chapter events throughout the year.
      </Feature>
    </div>
  </Section>

  <Section muted>
    <SectionHeading
      title="Leadership"
      description="Current officers of the Rice University SIAM Student Chapter."
      centered
    />
    <OfficerList headingLevel="h3" limit={3} />
    <p class="section-footer">
      <Link href="/leadership">Meet the leadership team</Link>
    </p>
  </Section>

  {
    partners.length > 0 && (
      <Section>
        <SectionHeading title="Partners" description="Organizations we work with." centered />
        <PartnerList partners={partners} />
      </Section>
    )
  }
</DefaultLayout>
