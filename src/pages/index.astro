---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import EventList from '@components/EventList.astro'
import OfficerList from '@components/OfficerList.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getUpcomingEvents } from '@utils/events'
import { getSite } from '@utils/siteData'

const site = getSite()
const upcomingEvents = (await getUpcomingEvents()).slice(0, 3)
---

<DefaultLayout title={site.seo.title} description={site.seo.description} useTitleTemplate={false}>
  <Hero />

  <section class="my-24">
    <div class="container">
      <Heading level="h2" class="mb-8">About Rice SIAM</Heading>
      <p class="mb-12 max-w-3xl text-xl">
        Rice SIAM is a student community for people interested in applied mathematics, computational science, scientific
        computing, and related fields at Rice University. We organize academic, professional, and social activities
        for undergraduate and graduate students.
      </p>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
        <Feature icon="lucide:sigma" title="Applied mathematics">
          Explore mathematical ideas used in science, engineering, and data-driven research.
        </Feature>
        <Feature icon="lucide:cpu" title="Computational science">
          Connect with students working on scientific computing, modeling, and computation.
        </Feature>
        <Feature icon="lucide:users" title="Student community">
          Meet peers, hear from speakers, and take part in chapter events throughout the year.
        </Feature>
      </div>
      <p class="mt-12">
        <Link href="/about">Learn more about the chapter</Link>
      </p>
    </div>
  </section>

  <section class="my-24">
    <div class="container">
      <Heading level="h2" class="mb-8">Upcoming events</Heading>
      <EventList events={upcomingEvents} headingLevel="h3" />
      <p class="mt-8">
        <Link href="/events">View all events</Link>
      </p>
    </div>
  </section>

  <section class="my-24">
    <div class="container">
      <Heading level="h2" class="mb-8">Leadership</Heading>
      <OfficerList headingLevel="h3" limit={3} />
      <p class="mt-8">
        <Link href="/leadership">Meet the full leadership team</Link>
      </p>
    </div>
  </section>
</DefaultLayout>
