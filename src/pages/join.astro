---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import Feature from '@components/Feature.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
---

<DefaultLayout
  title="Join"
  description="How to get involved with the Rice University SIAM Student Chapter."
>
  <PageHeader
    title="Join Rice SIAM"
    subtitle="A student community for applied mathematics and computational science at Rice."
  />

  <Section narrow>
    <SectionHeading title="Who should join" />
    <p>
      Rice SIAM is for Rice University students interested in applied mathematics, computational science, scientific
      computing, and related fields. Undergraduate and graduate students are welcome.
    </p>
  </Section>

  <Section muted>
    <SectionHeading title="Why join" centered />
    <div class="feature-grid">
      <Feature icon="lucide:users" title="Meet other students">
        Find peers who care about mathematics, computation, and related research.
      </Feature>
      <Feature icon="lucide:calendar" title="Take part in events">
        Attend talks, workshops, and other chapter activities as they are announced.
      </Feature>
      <Feature icon="lucide:book-open" title="Stay connected to the field">
        Learn more about SIAM and the broader applied mathematics community.
      </Feature>
    </div>
  </Section>

  <Section narrow>
    <SectionHeading title="How to get involved" />
    <div class="space-content">
      <p>
        Membership details, mailing-list instructions, and meeting information will be posted here as they are
        confirmed. Until then, you can:
      </p>
      <ul>
        <li>
          Watch the <Link href="/events">events page</Link> for upcoming activities
        </li>
        <li>
          Visit the <Link href="/contact">contact page</Link> for current public channels
        </li>
        <li>
          Follow the chapter organization on
          <Link href="https://github.com/Rice-SIAM" isExternal>GitHub</Link>
        </li>
      </ul>
      <p>
        There is no published fee, application, or eligibility rule on this site. Those details will appear only after
        chapter leadership confirms them.
      </p>
    </div>
  </Section>
</DefaultLayout>
