---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import OfficerList from '@components/OfficerList.astro'
import OfficerHistory from '@components/OfficerHistory.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { getOfficerHistory } from '@utils/siteData'

const pastTerms = getOfficerHistory()
---

<DefaultLayout title="Leadership" description="Current and past officers of the Rice University SIAM Student Chapter.">
  <PageHeader title="Leadership" subtitle="Officers of the Rice University SIAM Student Chapter." />

  <Section>
    <SectionHeading title="Current officers" />
    <OfficerList headingLevel="h3" />
  </Section>

  {
    pastTerms.length > 0 && (
      <Section muted>
        <SectionHeading title="Past officers" />
        <OfficerHistory terms={pastTerms} headingLevel="h3" />
      </Section>
    )
  }
</DefaultLayout>
