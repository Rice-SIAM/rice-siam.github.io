---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import OfficerList from '@components/OfficerList.astro'
import Section from '@components/Section.astro'
---

<DefaultLayout
  title="Leadership"
  description="Current officers of the Rice University SIAM Student Chapter."
>
  <PageHeader
    title="Leadership"
    subtitle="Current officers of the Rice University SIAM Student Chapter."
  />
  <Section>
    <h2 class="sr-only">Current officers</h2>
    <OfficerList headingLevel="h3" />
    <p class="section-footer">
      Officer information is updated at the start of each academic term. Additional details will be added as they are
      confirmed.
    </p>
  </Section>
</DefaultLayout>
