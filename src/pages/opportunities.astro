---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import OpportunityList from '@components/OpportunityList.astro'
import Section from '@components/Section.astro'
import SectionHeading from '@components/SectionHeading.astro'
import { Link } from 'accessible-astro-components'
import { getOpenOpportunitySections } from '@utils/opportunities'

const sections = await getOpenOpportunitySections()
---

<DefaultLayout
  title="Opportunities"
  description="Internships, postdocs, fellowships, and jobs shared with the Rice University SIAM Student Chapter."
>
  <PageHeader
    title="Opportunities"
    subtitle="Internships, postdocs, fellowships, and jobs shared with the chapter. Apply on the listing website."
  />

  {
    sections.map((section, index) => (
      <Section muted={index % 2 === 1} id={section.id}>
        <SectionHeading title={section.title} />
        <OpportunityList opportunities={section.opportunities} headingLevel="h3" emptyMessage={section.emptyMessage} />
      </Section>
    ))
  }

  <Section muted={sections.length % 2 === 1}>
    <SectionHeading title="Other places to look" />
    <ul class="resource-list">
      <li>
        <Link href="https://jobs.siam.org/" isExternal>SIAM Career Center</Link> — internships, postdocs, and jobs posted
        with SIAM.
      </li>
      <li>
        <Link href="https://ccd.rice.edu/students/career-opportunities/internships-jobs" isExternal>
          Rice Center for Career Development
        </Link> — internships, jobs, and 12twenty for Rice students.
      </li>
      <li>
        <Link href="https://graduate.rice.edu/resources/fellowship-coaching" isExternal>
          GPS Fellowship Coaching
        </Link> — one-on-one coaching for Rice graduate students applying to major external fellowships.
      </li>
      <li>
        <Link href="https://github.com/northwesternfintech/2027QuantInternships" isExternal>
          2027 quant internships
        </Link> — quant research, trading, and related internships listed by firm, maintained by Northwestern FinTech.
      </li>
      <li>
        <Link href="https://github.com/speedyapply/2027-SWE-College-Jobs" isExternal> 2027 SWE college jobs </Link> — internships
        and new-graduate software roles, including some quant-dev openings.
      </li>
      <li>
        <Link href="https://github.com/SimplifyJobs/Summer2027-Internships" isExternal> Summer 2027 internships </Link> —
        software, data, AI, quant, and related internships, updated daily by Simplify and Pitt CSC.
      </li>
    </ul>
    <p>
      To share an opening with the chapter, use the <Link href="/contact">contact page</Link>.
    </p>
  </Section>
</DefaultLayout>
