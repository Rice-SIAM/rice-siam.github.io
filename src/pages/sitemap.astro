---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading } from 'accessible-astro-components'

const staticPages = [
  {
    title: 'Home',
    url: '/',
    description: 'Overview of the Rice University SIAM Student Chapter.',
  },
  {
    title: 'About',
    url: '/about',
    description: 'Who the chapter is and what it does.',
  },
  {
    title: 'Events',
    url: '/events',
    description: 'Upcoming and past chapter events.',
  },
  {
    title: 'Leadership',
    url: '/leadership',
    description: 'Current chapter officers.',
  },
  {
    title: 'Join',
    url: '/join',
    description: 'How to get involved with Rice SIAM.',
  },
  {
    title: 'Contact',
    url: '/contact',
    description: 'Public contact information for the chapter.',
  },
  {
    title: 'Accessibility statement',
    url: '/accessibility-statement',
    description: 'Accessibility commitment, feedback, and known limitations.',
  },
]
---

<DefaultLayout
  title="Sitemap"
  description="A list of the main pages on the Rice University SIAM Student Chapter website."
>
  <PageHeader title="Sitemap" subtitle="Main pages on this website." bgType="bordered" />
  <section class="my-16">
    <div class="container">
      <Heading level="h2" class="mb-6">Main pages</Heading>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          staticPages.map((page) => (
            <article>
              <Heading level="h3" size="h6" class="mb-3">
                <a href={page.url}>{page.title}</a>
              </Heading>
              <p>{page.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  article {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-large);
    padding: 1rem;
  }
</style>
