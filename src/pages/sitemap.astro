---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading } from 'accessible-astro-components'
import { getNavigation } from '@utils/siteData'
import type { NavigationItem } from '@utils/defineThemeConfig'

const descriptions: Record<string, string> = {
  '/': 'Overview of the Rice University SIAM Student Chapter.',
  '/about': 'Who the chapter is and what it does.',
  '/events': 'Upcoming and past chapter events.',
  '/opportunities': 'Internships, postdocs, and jobs shared with the chapter.',
  '/leadership': 'Current chapter officers.',
  '/get-involved': 'How to take part in chapter events and optional SIAM student membership.',
  '/contact': 'Public contact information for the chapter.',
  '/accessibility-statement': 'Accessibility commitment, feedback, and known limitations.',
}

const extraPages = [
  {
    title: 'Accessibility statement',
    url: '/accessibility-statement',
    description: descriptions['/accessibility-statement'],
  },
]

function navPages(items: NavigationItem[]) {
  return items.flatMap((item) => {
    if (item.type === 'dropdown') {
      return item.items.map((child) => ({
        title: child.label,
        url: child.href,
        description: descriptions[child.href] ?? '',
      }))
    }

    return [
      {
        title: item.label,
        url: item.href,
        description: descriptions[item.href] ?? '',
      },
    ]
  })
}

const staticPages = [...navPages(getNavigation().items), ...extraPages]
---

<DefaultLayout
  title="Sitemap"
  description="A list of the main pages on the Rice University SIAM Student Chapter website."
>
  <PageHeader title="Sitemap" subtitle="Main pages on this website." />
  <section class="site-section">
    <div class="container">
      <Heading level="h2" class="mb-6">Main pages</Heading>
      <div class="feature-grid">
        {
          staticPages.map((page) => (
            <article class="feature-card">
              <Heading level="h3" size="h6">
                <a href={page.url}>{page.title}</a>
              </Heading>
              {page.description ? <p>{page.description}</p> : null}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</DefaultLayout>
